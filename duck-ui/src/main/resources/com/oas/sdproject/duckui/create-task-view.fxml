<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox alignment = "CENTER" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.oas.sdproject.duckui.CreateTaskController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <Label fx:id="AddLabel" graphicTextGap="10.0" text="Add New Task" textAlignment="CENTER">
            <graphic>
                <ImageView fx:id="duckIcon" fitHeight="40.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../../assets/images/ic_duck.png" />
                    </image>
                </ImageView>
            </graphic>
            <VBox.margin>
                <Insets top="25.0" />
            </VBox.margin>
        </Label>
        <TextField fx:id="taskTitle" prefHeight="25.0" prefWidth="260.0" promptText="Title">
            <VBox.margin>
                <Insets bottom="5.0" left="20.0" right="20.0" top="10.0" />
            </VBox.margin></TextField>
        <TextArea fx:id="taskDesc" prefHeight="113.0" prefWidth="228.0" promptText="Description" wrapText="true">
            <VBox.margin>
                <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
            </VBox.margin>
        </TextArea>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <Label alignment="CENTER" contentDisplay="BOTTOM" text="Priority">
                    <graphic>
                        <ChoiceBox fx:id="priorityChoiceBox" prefWidth="150.0" />
                    </graphic>
                    <HBox.margin>
                        <Insets left="100.0" right="20.0" top="20.0" />
                    </HBox.margin>
                </Label>
                <Label contentDisplay="BOTTOM" text="Due Date">
                    <graphic>
                        <DatePicker fx:id="dueDatePicker" />
                    </graphic>
                    <HBox.margin>
                        <Insets left="100.0" right="100.0" top="20.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <Button fx:id="addTaskButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="92.0" style="-fx-background-color: #fca100;" text="Add Task">
                    <HBox.margin>
                        <Insets left="125.0" right="50.0" top="25.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelButtonClicked" prefHeight="25.0" prefWidth="106.0" style="-fx-background-color: e7e7e7;" text="Cancel">
                    <HBox.margin>
                        <Insets left="150.0" right="125.0" top="25.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </children>

</VBox>
