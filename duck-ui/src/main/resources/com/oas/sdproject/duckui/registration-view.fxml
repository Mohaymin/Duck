<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            alignment="CENTER"
            fx:controller="com.oas.sdproject.duckui.RegistrationController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <Label fx:id="welcomeLabel" graphicTextGap="25.0" text="Welcome to Duck!">
            <graphic>
                <ImageView fx:id="duckIcon" fitHeight="63.0" fitWidth="62.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../../assets/images/ic_duck.png" />
                    </image>
                </ImageView>
            </graphic>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>
        <TextField fx:id="firstNameField" prefHeight="25.0" prefWidth="572.0" promptText="First Name">
            <VBox.margin>
                <Insets bottom="5.0" left="40.0" right="40.0" top="10.0" />
            </VBox.margin></TextField>
        <TextField fx:id="lastNameField" prefHeight="25.0" prefWidth="381.0" promptText="Last Name">
            <VBox.margin>
                <Insets bottom="5.0" left="40.0" right="40.0" top="10.0" />
            </VBox.margin></TextField>
        <TextField fx:id="emailField" promptText="Email">
            <VBox.margin>
                <Insets bottom="5.0" left="40.0" right="40.0" top="10.0" />
            </VBox.margin></TextField>
        <PasswordField fx:id="passwordField" promptText="Password">
            <VBox.margin>
                <Insets bottom="5.0" left="40.0" right="40.0" top="10.0" />
            </VBox.margin></PasswordField>
        <PasswordField fx:id="confirmPasswordField" prefHeight="25.0" prefWidth="357.0" promptText="Confirm Password">
            <VBox.margin>
                <Insets bottom="5.0" left="40.0" right="40.0" top="10.0" />
            </VBox.margin></PasswordField>
        <Button fx:id="registerButton" mnemonicParsing="false" onAction="#onRegisterButtonClicked" style="-fx-background-color: #fca100;" text="Register" textAlignment="CENTER">
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin></Button>
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBackButtonClicked" style="-fx-background-color: e7e7e7;" text="Back" />
    </children>

</VBox>
